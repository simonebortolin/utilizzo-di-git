\begin{tikzpicture}
    % Commit DAG
    \gitDAG[grow right sep = 2em]{
        a47c3 -- { b325c --  
            c10b9 -- da985 -- ed489 -- e432a,
            169a6 -- 2c33a -- 3ba22,
        }
    };
    \gitbranchold[main-old]    % node name
		{main} % node text
		{above=of ed489}    % node placement
		{ed489}             % target        % target
		% HEAD reference
	\gitHEADold
		{left=of main-old} % node placement
		{main-old}          % target
    % Remote branch
    \gitbranch    % node name
    {main} % node text
    {above=of e432a}    % node placement
    {e432a}             % target
    % Branch
    \gitbranch
    {new-feature}     % node name and text 
    {below=of 3ba22} % node placement
    {3ba22}          % target
    % HEAD reference
    \gitHEAD
    {right=of main} % node placement
    {main}          % target
    \node (cherry) at ($(ed489)!0.6!(e432a)$) {};
    \node () [below of=e432a] {\small\texttt{git merge --squash new-feature}};
    \draw [DAGrefedge, bend left] (cherry) to (new-feature);
\end{tikzpicture}

