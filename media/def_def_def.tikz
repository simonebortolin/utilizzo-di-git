\newcommand\filelist{{"progetto.cpp","progetto.def.cpp","progetto.def.last.cpp","progetto.def.last.update.cpp","progetto.def.last.update.def.cpp","progetto.def.v2.cpp","progetto.def.v3.cpp","progetto.v2.def.cpp","progetto.v2.def.def.check.bugfix.cpp","progetto.v2.def.def.check.bugfix.v2.bis.cpp","progetto.v2.def.def.check.bugfix.v2.cpp","progetto.v2.def.def.check.cpp","progetto.v2.def.def.cpp"}}
\begin{tikzpicture}[
    y=3ex, 
    x=1.5ex,
    mkdir/.pic={%
        \draw [pic actions] (0,-4*\mkdirsize) -- ++(0,8*\mkdirsize) -- ++(\mkdirsize,\mkdirsize) -- ++(5*\mkdirsize,0) -- ++(\mkdirsize,-\mkdirsize) -- ++(5*\mkdirsize,0) |- cycle;
    },
    touch/.pic={%
        \draw [pic actions] (0,-6*\touchsize) |- ++(5*\touchsize,12*\touchsize) edge ++(3*\touchsize,-3*\touchsize) |- ++(3*\touchsize,-3*\touchsize) |- cycle;
    },
    mkdir size/.store in=\mkdirsize,
    touch size/.store in=\touchsize,
    icon sep/.store in=\iconsep,
    icon sep from path/.store in=\iconsepfrompath,
    mkdir size=.15ex,
    touch size=.15ex,
    icon sep=1.5ex,
    icon sep from path=1ex
]
    \foreach \i in {0,...,12}
        \pic at (0,-\i) {touch}; 
    \foreach \i in {0,...,12}
        \node[anchor=west] at (1,-\i) {\texttt{\pgfmathparse{\filelist[\i]}\pgfmathresult}};
\end{tikzpicture}
